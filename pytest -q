[32m+[m[32m                raise TypeError([m
[32m+[m[32m                    "every grid cell must contain a string"[m
[32m+[m[32m                )[m
[32m+[m
[32m+[m[32m            if len(character) != 1:[m
[32m+[m[32m                raise GridValidationError([m
[32m+[m[32m                    "each grid cell must contain exactly one character"[m
[32m+[m[32m                )[m
