[32m+[m[32m            "timeout_seconds must be a number"[m
[32m+[m[32m        )[m
[32m+[m
[32m+[m[32m    if timeout_seconds <= 0:[m
[32m+[m[32m        raise ValueError([m
[32m+[m[32m            "timeout_seconds must be positive"[m
[32m+[m[32m        )[m
[32m+[m
[32m+[m[32m    # Copy the grid so the caller's data cannot be changed.[m
[32m+[m[32m    grid = [row.copy() for row in shelf_grid][m
[32m+[m
[32m+[m[32m    rows = len(grid)[m
[32m+[m[32m    columns = len(grid[0])[m
[32m+[m
[32m+[m[32m    visited: set[tuple[int, int]] = set()[m
[32m+[m
[32m+[m[32m    metrics = {[m
[32m+[m[32m        "cells_checked": 0,[m
[32m+[m[32m        "paths_explored": 0,[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    start_time = perf_counter()[m
[32m+[m
[32m+[m[32m    def check_timeout() -> None:[m
[32m+[m[32m        """Raise an exception if the search timed out."""[m
[32m+[m
[32m+[m[32m        elapsed = perf_counter() - start_time[m
[32m+[m
[32m+[m[32m        if elapsed > timeout_seconds:[m
[32m+[m[32m            raise SearchTimeoutError([m
[32m+[m[32m                "product-code search exceeded timeout"[m
[32m+[m[32m            )[m
[32m+[m
[32m+[m[32m    def backtrack([m
[32m+[m[32m        row: int,[m
[32m+[m[32m        column: int,[m
[32m+[m[32m        code_index: int,[m
[32m+[m[32m    ) -> bool:[m
[32m+[m[32m        """Search recursively from one grid position."""[m
