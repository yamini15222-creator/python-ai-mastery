[32m+[m[32m    _validate_grid([m
[32m+[m[32m        shelf_grid,[m
[32m+[m[32m        max_rows,[m
[32m+[m[32m        max_columns,[m
[32m+[m[32m    )[m
[32m+[m
[32m+[m[32m    _validate_product_code([m
[32m+[m[32m        product_code,[m
[32m+[m[32m        max_word_length,[m
[32m+[m[32m    )[m
