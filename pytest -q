[32m+[m[32m    if not shelf_grid:[m
[32m+[m[32m        raise GridValidationError("shelf_grid must not be empty")[m
[32m+[m
[32m+[m[32m    if type(max_rows) is not int or max_rows <= 0:[m
[32m+[m[32m        raise ValueError("max_rows must be a positive integer")[m
[32m+[m
[32m+[m[32m    if type(max_columns) is not int or max_columns <= 0:[m
[32m+[m[32m        raise ValueError("max_columns must be a positive integer")[m
[32m+[m
[32m+[m[32m    if len(shelf_grid) > max_rows:[m
[32m+[m[32m        raise GridValidationError([m
[32m+[m[32m            f"grid rows must not exceed {max_rows}"[m
[32m+[m[32m        )[m
[32m+[m
[32m+[m[32m    column_count = None[m
[32m+[m
[32m+[m[32m    for row in shelf_grid:[m
[32m+[m[32m        if type(row) is not list:[m
[32m+[m[32m            raise TypeError("every grid row must be a list")[m
[32m+[m
[32m+[m[32m        if not row:[m
[32m+[m[32m            raise GridValidationError([m
[32m+[m[32m                "grid rows must not be empty"[m
[32m+[m[32m            )[m
[32m+[m
[32m+[m[32m        if column_count is None:[m
[32m+[m[32m            column_count = len(row)[m
[32m+[m[32m        elif len(row) != column_count:[m
[32m+[m[32m            raise GridValidationError([m
[32m+[m[32m                "shelf_grid must be rectangular"[m
[32m+[m[32m            )[m
[32m+[m
[32m+[m[32m        if len(row) > max_columns:[m
[32m+[m[32m            raise GridValidationError([m
[32m+[m[32m                f"grid columns must not exceed {max_columns}"[m
[32m+[m[32m            )[m
[32m+[m
[32m+[m[32m        for character in row:[m
